{
  "name": "notifox-reminders",
  "version": "0.1.0",
  "description": "Exports valid Notifox reminders from Obsidian Tasks to JSON.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test"
  },
  "license": "MIT",
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.17",
    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild": "^0.25.5",
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "obsidian": "latest",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.59.1",
    "vitest": "^3.2.4"
  }
}
